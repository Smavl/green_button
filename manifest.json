{
  "manifest_version": 3,
  "name": "Green Button",
  "version": "0.1.0",
  "description": "Shows on a GitHub repo page whether private vulnerability reporting (\"Report a vulnerability\") is enabled.",
  "browser_specific_settings": {
    "gecko": {
      "id": "green-button@smavl",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html"
  }
}
